# ─── Harar Open Air Cinema — environment template ─────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# API server port (Vite proxies /api here in development).
PORT=3001

# PostgreSQL connection string (app database; migrations run on boot).
# Local default matches `docker compose up -d` (postgres:17, user `harar`).
# TEST/prod: paste the Neon connection string (it already includes
# ?sslmode=require — the app negotiates TLS from the URL, no extra flags).
DATABASE_URL=postgres://harar:harar@localhost:5432/harar_cinema

# TESTS ONLY: Postgres server + maintenance database that `npm run test:server`
# uses to create one fresh database per test (dropped afterwards). Point it at
# the `postgres` database on the same local server — never at real data.
TEST_DATABASE_URL=postgres://harar:harar@localhost:5432/postgres

# REQUIRED in production: long random string for admin session signing.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Seed admin (used by `npm run db:seed` when the user doesn't exist yet).
ADMIN_NAME=Harar Cinema Admin
ADMIN_EMAIL=admin@harar-cinema.local
ADMIN_PASSWORD=change-me-before-launch
# One-time password reset switch (default off — leave unset). When exactly
# 'true', the next boot rewrites the EXISTING seed admin's password hash from
# ADMIN_PASSWORD above (never creates/deletes); remove this variable and
# redeploy right after verifying the new login. Absent/any other value =
# normal boot, existing password untouched.
#ADMIN_PASSWORD_RESET=true

# ─── Frontend (Vite) ─────────────────────────────────────────────────
# API base URL. Same-origin `/api` works in dev (proxy) and prod (static).
# VITE_API_BASE=/api
# Pure-frontend mode with localStorage demo data (no backend, no login):
# VITE_USE_MOCK_API=true

# ─── Payments (Chapa aggregator) ──────────────────────────────────────
# All five customer methods (eBirr, Coopay, CBE, telebirr, mobile banking)
# are served through Chapa's hosted checkout. Leave CHAPA_SECRET_KEY empty
# to keep every method honestly "coming soon".
# Paste the secret key from the Chapa dashboard (test or live key):
CHAPA_SECRET_KEY=
# Separate webhook "Secret Hash" (Chapa dashboard → profile settings →
# Webhooks tab). This is the ONLY key that authenticates inbound webhooks;
# the API key above never verifies webhooks. Empty = every webhook is
# rejected (fail closed). Never reuse the API key value here.
CHAPA_WEBHOOK_SECRET=
# Must match the key type above: test | live
CHAPA_MODE=test
# Override only if Chapa publishes a new base URL (default https://api.chapa.co/v1)
# CHAPA_BASE_URL=https://api.chapa.co/v1

# OPERATOR-CONFIRMED methods (comma-separated). Chapa enables rails per merchant
# account and offers no API to query them, so a method is advertised to
# customers ONLY when listed here AND its provider is configured. Confirm each
# method in the merchant's REAL checkout before adding it. Unset/empty =
# nothing advertised (fail closed). Unknown codes fail the boot loudly.
# Example (after confirming all five on the live merchant checkout):
# PAYMENT_METHODS=EBIRR,COOPAY,CBE,TELEBIRR,MOBILE_BANKING

# Public URLs used for provider callback + return links.
# On Render these may be omitted: the app falls back to Render's injected
# RENDER_EXTERNAL_URL (public https origin). Set explicitly for custom domains.
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001

# Minutes a booking's seats are held while payment is open.
PAYMENT_WINDOW_MINUTES=30
